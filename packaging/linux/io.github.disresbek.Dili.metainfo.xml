<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>@PROJECT_FQDN@</id>

  <name>Dili</name>
  <summary>Game streaming host for Moonlight</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>@PROJECT_LICENSE@</project_license>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
    <control>gamepad</control>
  </supports>

  <url type="homepage">https://github.com/Disresbek/dili-stream</url>
  <url type="bugtracker">https://github.com/Disresbek/dili-stream/issues</url>

  <description>
    <p>Dili lets you play the games on your Linux PC on your TV, phone or tablet with any Moonlight client.
    Every device gets its own virtual screen that matches its resolution and refresh rate.</p>
    <p>Dili is based on Sunshine by LizardByte. A setup wizard takes care of controller access, network access
    and screen sharing on first start.</p>
    <p>NOTE: Dili uses a self-signed certificate. The web browser will report it as not secure, but it is safe.</p>
  </description>

  <releases>
    <release version="@PROJECT_VERSION@" date="@PROJECT_YEAR@-@PROJECT_MONTH@-@PROJECT_DAY@">
      <url>https://github.com/Disresbek/dili-stream</url>
      <description>
        <p>See the changelog on GitHub</p>
      </description>
    </release>
  </releases>

  <developer id="dev.lizardbyte">
    <name>LizardByte</name>
  </developer>
  <screenshots>
    <screenshot type="default">
      <image>https://app.lizardbyte.dev/Sunshine/assets/img/screenshots/01-sunshine-welcome-page.png</image>
      <caption>Sunshine welcome page</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.0">
    <content_attribute id="language-profanity">moderate</content_attribute>
    <content_attribute id="language-humor">mild</content_attribute>
    <content_attribute id="money-purchasing">mild</content_attribute>
  </content_rating>
  <launchable type="desktop-id">@PROJECT_FQDN@.desktop</launchable>
</component>
